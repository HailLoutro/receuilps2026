rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Profils utilisateurs ──────────────────────────────────
    match /users/{uid} {
      // Chacun peut lire et écrire son propre profil
      // (nécessaire pour l'auto-provisioning client)
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Admin peut tout lire/écrire
      allow read, write: if isAdmin();
    }

    // ── Template ─────────────────────────────────────────────
    match /template/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Clients (credentials) ────────────────────────────────
    // ⚠️ LECTURE PUBLIQUE : nécessaire pour que le client puisse
    // vérifier ses credentials AVANT de créer son compte Auth.
    // Le password est en clair — acceptable pour un outil B2B interne.
    match /clients/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Données client (réponses au recueil) ─────────────────
    match /clients/{slug}/data/{docId} {
      // Admin : lecture + suppression
      allow read, write: if isAdmin();
      // Client : lecture + écriture de SES données
      allow read, write: if isClientOf(slug);
    }

    // ── Meta (backups, etc.) ─────────────────────────────────
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Helpers ──────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isClientOf(slug) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "client" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.slug == slug;
    }
  }
}
