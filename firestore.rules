rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Profils utilisateurs ──────────────────────────────────
    match /users/{uid} {
      // Chacun peut lire/écrire son propre profil (nécessaire pour anonymous auth client)
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Admin peut tout lire
      allow read: if isAdmin();
      // Admin peut écrire (créer d'autres admins)
      allow write: if isAdmin();
    }

    // ── Template global ───────────────────────────────────────
    match /template/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Clients (credentials) ────────────────────────────────
    match /clients/{slug} {
      // Admin : full access (CRUD)
      allow read, write: if isAdmin();
      // Tout user authentifié peut lire (nécessaire pour login client via anonymous)
      allow read: if request.auth != null;
    }

    // ── Données client ───────────────────────────────────────
    match /clients/{slug}/data/{docId} {
      // Admin : lecture ET suppression (FIX: ajout write pour admin)
      allow read, write: if isAdmin();
      // Client : lecture + écriture de ses propres données
      allow read, write: if isClientOf(slug);
    }

    // ── Meta (backups, etc.) ─────────────────────────────────
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Helpers ──────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isClientOf(slug) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "client" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.slug == slug;
    }
  }
}
