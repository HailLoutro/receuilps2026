rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Profils utilisateurs ──────────────────────────────────
    // Chaque user peut lire son propre profil.
    // Seuls les admins peuvent lire tous les profils.
    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // ── Template global ───────────────────────────────────────
    // Lecture pour tous les authentifiés.
    // Écriture réservée aux admins.
    match /template/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Clients ───────────────────────────────────────────────
    // Admins : full access.
    // Client : read son propre doc.
    match /clients/{slug} {
      allow read, write: if isAdmin();
      allow read: if isClientOf(slug);
    }

    // ── Données client ────────────────────────────────────────
    // Admin : lecture.
    // Client : lecture + écriture de ses propres données.
    match /clients/{slug}/data/{docId} {
      allow read: if isAdmin() || isClientOf(slug);
      allow write: if isClientOf(slug);
    }

    // ── Helpers ───────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isClientOf(slug) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "client" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.slug == slug;
    }
  }
}
